# =============================================================================
# Valora - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.

# Documentation base URL (used in CLI help output and error messages)
VALORA_DOCS_URL=https://github.com/windagency/valora.ai/documentation/README.md

# Plugin registry override — set to a local file path to skip the remote fetch (useful for development/testing)
VALORA_PLUGIN_REGISTRY=data/plugins/registry.json

# Remote plugin registry URL override — defaults to the repository's raw GitHub URL derived from package.json
VALORA_PLUGIN_REGISTRY_URL=https://raw.githubusercontent.com/windagency/valora.ai/main/data/plugins/registry.json
