{
	"name": "@windagency/valora-plugin-docs",
	"version": "1.0.0",
	"description": "Documentation generation commands for Valora (generate-docs, generate-all-documentation). Requires valora-plugin-engineering for the lead agent.",
	"keywords": [
		"valora",
		"valora-plugin",
		"ai",
		"documentation",
		"docs",
		"generator",
		"workflow",
		"automation"
	],
	"author": "Damien TIVELET <damien@wind-agency.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/windagency/valora.ai"
	},
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@10.19.0",
	"volta": {
		"node": "22.21.0",
		"pnpm": "10.19.0"
	},
	"scripts": {
		"build": "true",
		"clean": "true",
		"beautify": "prettier --check \"**/*.+(js|jsx|ts|tsx|json|md|yml|yaml)\"",
		"beautify:fix": "prettier --write \"**/*.+(js|jsx|ts|tsx|json|md|yml|yaml)\"",
		"format": "pnpm beautify:fix",
		"test": "true"
	},
	"files": [
		"valora-plugin.json",
		"commands"
	],
	"peerDependencies": {
		"@windagency/valora": ">=0.1.0",
		"@windagency/valora-plugin-engineering": ">=1.0.0"
	},
	"devDependencies": {
		"@windagency/valora-plugin-engineering": "workspace:*"
	}
}
