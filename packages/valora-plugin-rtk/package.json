{
	"name": "@windagency/valora-plugin-rtk",
	"version": "1.0.0",
	"description": "RTK (Rust Token Killer) integration for Valora — transparently prepends rtk to known-noisy CLI tools, reducing LLM token consumption by 60–90%.",
	"keywords": [
		"valora",
		"valora-plugin",
		"rtk",
		"token-reduction",
		"hooks",
		"cli",
		"rust"
	],
	"author": "Damien TIVELET <damien@wind-agency.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/windagency/valora.ai"
	},
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@10.19.0",
	"volta": {
		"node": "22.21.0",
		"pnpm": "10.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf ./dist",
		"lint": "eslint --color",
		"lint:fix": "eslint --color --fix",
		"beautify": "prettier --check \"**/*.+(js|jsx|ts|tsx|json|md|yml|yaml)\"",
		"beautify:fix": "prettier --write \"**/*.+(js|jsx|ts|tsx|json|md|yml|yaml)\"",
		"format": "pnpm beautify:fix && pnpm lint:fix",
		"test": "vitest run",
		"prepublishOnly": "pnpm clean && pnpm build && pnpm test"
	},
	"files": [
		"valora-plugin.json",
		"hooks.json",
		"hooks/",
		"dist/"
	],
	"peerDependencies": {
		"@windagency/valora": ">=0.1.0"
	},
	"devDependencies": {
		"@windagency/valora-plugin-api": "workspace:*",
		"vitest": "^1.0.0"
	}
}
