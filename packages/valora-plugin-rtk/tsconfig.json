{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"declaration": false,
		"declarationMap": false,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"outDir": "dist",
		"paths": {
			"plugins/*": ["../../dist/plugins/*"]
		},
		"rootDir": "src",
		"sourceMap": false
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
