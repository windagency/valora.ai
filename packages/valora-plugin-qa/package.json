{
	"name": "@windagency/valora-plugin-qa",
	"version": "1.0.1",
	"description": "QA agent and testing workflow commands for Valora (test, validate-coverage, pre-check).",
	"keywords": [
		"valora",
		"valora-plugin",
		"ai",
		"agent",
		"testing",
		"qa",
		"quality-assurance",
		"test-coverage",
		"workflow",
		"automation"
	],
	"author": "Damien TIVELET <damien@wind-agency.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/windagency/valora.ai"
	},
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@10.19.0",
	"volta": {
		"node": "22.21.0",
		"pnpm": "10.19.0"
	},
	"scripts": {
		"build": "true",
		"clean": "true",
		"beautify": "prettier --check \"**/*.+(js|jsx|ts|tsx|json|md|yml|yaml)\"",
		"beautify:fix": "prettier --write \"**/*.+(js|jsx|ts|tsx|json|md|yml|yaml)\"",
		"format": "pnpm beautify:fix",
		"test": "true"
	},
	"files": [
		"valora-plugin.json",
		"agents",
		"commands"
	],
	"peerDependencies": {
		"@windagency/valora": ">=0.1.0"
	}
}
