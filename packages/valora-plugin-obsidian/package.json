{
	"name": "@windagency/valora-plugin-obsidian",
	"version": "1.0.0",
	"description": "Bridges the Valora memory vault to Obsidian — sets up vault config and opens it.",
	"keywords": [
		"valora",
		"valora-plugin",
		"obsidian",
		"memory",
		"vault"
	],
	"author": "Damien TIVELET <damien@wind-agency.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/windagency/valora.ai"
	},
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@10.19.0",
	"volta": {
		"node": "22.21.0",
		"pnpm": "10.19.0"
	},
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
		"clean": "rm -rf ./dist",
		"lint": "eslint --color",
		"lint:fix": "eslint --color --fix",
		"beautify": "prettier --check \"**/*.+(js|jsx|ts|tsx|json|md|yml|yaml)\"",
		"beautify:fix": "prettier --write \"**/*.+(js|jsx|ts|tsx|json|md|yml|yaml)\"",
		"format": "pnpm beautify:fix && pnpm lint:fix",
		"test": "vitest run",
		"prepublishOnly": "pnpm clean && pnpm build"
	},
	"files": [
		"valora-plugin.json",
		"dist"
	],
	"peerDependencies": {
		"@windagency/valora": ">=0.1.0"
	},
	"devDependencies": {
		"esbuild": "^0.28.0",
		"zod": "^3.24.0"
	}
}
