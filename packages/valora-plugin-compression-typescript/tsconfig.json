{
	"compilerOptions": {
		"alwaysStrict": true,
		"declaration": false,
		"declarationMap": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "dist",
		"paths": {
			"@windagency/valora-plugin-api": ["../../packages/valora-plugin-api/src/index"]
		},
		"rootDir": "src",
		"skipLibCheck": true,
		"sourceMap": false,
		"strict": true,
		"target": "ES2022",
		"types": ["node"]
	},
	"exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts", "__tests__"],
	"include": ["src/**/*"]
}
